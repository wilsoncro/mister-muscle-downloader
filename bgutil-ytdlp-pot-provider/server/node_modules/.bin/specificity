#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../.deno/@bramus+specificity@2.4.2/node_modules/@bramus/specificity/bin/cli.js" "$@"
else
  exec node  "$basedir/../.deno/@bramus+specificity@2.4.2/node_modules/@bramus/specificity/bin/cli.js" "$@"
fi
